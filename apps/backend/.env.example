PRODUCTION_PLATFORM_DURO_API_KEY=
# Bridge GPT Token credentials stay in git-ignored auth-files.
PRODUCTION_PLATFORM_BRIDGE_ENV_FILE=apps/backend/auth-files/bridgefloods.env
PRODUCTION_PLATFORM_BRIDGE_ACCESS_TOKEN=
PRODUCTION_PLATFORM_BRIDGE_REFRESH_TOKEN=
PRODUCTION_PLATFORM_BRIDGE_WHITELIST_PATH=apps/backend/auth-files/bridgefloods_whitelist.csv
PRODUCTION_PLATFORM_BRIDGE_AUTOMATION_ENABLED=false
PRODUCTION_PLATFORM_BRIDGE_EMAIL_PROVIDER=gmail
PRODUCTION_PLATFORM_BRIDGE_GMAIL_TOKEN_PATH=apps/backend/auth-files/bridge-gmail-token.json
PRODUCTION_PLATFORM_BRIDGE_EMAIL_FROM=
PRODUCTION_PLATFORM_BRIDGE_ADMIN_EMAIL=
PRODUCTION_PLATFORM_BRIDGE_SMTP_HOST=
PRODUCTION_PLATFORM_BRIDGE_SMTP_PORT=587
PRODUCTION_PLATFORM_BRIDGE_SMTP_USERNAME=
PRODUCTION_PLATFORM_BRIDGE_SMTP_PASSWORD=
PRODUCTION_PLATFORM_BRIDGE_SMTP_SSL=false
PRODUCTION_PLATFORM_BRIDGE_SMTP_STARTTLS=true
# Standard OpenAI-compatible names. These take precedence when configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# Legacy platform-specific names remain supported for existing deployments.
PRODUCTION_PLATFORM_DURO_BASE_URL=https://mfgapi.duro.app/v1
PRODUCTION_PLATFORM_SUPPLEMENTARY_MATERIALS_DB_PATH=
# Supplies: read the source at startup, then hourly (disabled in simulating mode).
# Excel sources use the exact worksheet title; native Google Sheets use the gid.
# Scan from row 1, recognize the header, and stop at the first entirely empty row.
PRODUCTION_PLATFORM_SUPPLIES_AUTO_SYNC_ENABLED=true
PRODUCTION_PLATFORM_SUPPLIES_AUTO_SYNC_SECONDS=3600
PRODUCTION_PLATFORM_SUPPLIES_SPREADSHEET_ID=1GhGXTfEEXbN-LYry2bwKJirQJcKP4xAA
PRODUCTION_PLATFORM_SUPPLIES_SHEET_GID=921765553
PRODUCTION_PLATFORM_SUPPLIES_SHEET_TITLE=辅料料号
PRODUCTION_PLATFORM_LLM_API_KEY=
PRODUCTION_PLATFORM_LLM_BASE_URL=https://api.deepseek.com/v1
PRODUCTION_PLATFORM_LLM_MODEL=deepseek-chat
PRODUCTION_PLATFORM_LLM_TIMEOUT_SECONDS=180
PRODUCTION_PLATFORM_LLM_SOP_CHUNK_CHARS=16000
PRODUCTION_PLATFORM_LLM_SOP_MAX_TOKENS=8192
PRODUCTION_PLATFORM_LLM_SEMANTIC_MAX_WORKERS=4
PRODUCTION_PLATFORM_SOP_FULL_SEMANTIC_MAX_REFERENCES=120
# Optional, colon-separated on Linux/macOS. Defaults: ~/projects/opentrons,
# ~/projects/opentorns (legacy typo), and /opentrons.
PRODUCTION_PLATFORM_OPENTRONS_SOURCE_ROOTS=
# Optional directory containing setup_ssh_keys.sh. Defaults: /ssh-ot3,
# ~/ssh-ot3, and ~/projects/ssh-ot3.
PRODUCTION_PLATFORM_SSH_OT3_DIR=
# Directory containing the Opentrons Makefile used by the code flash page.
# Defaults to /opentrons, then ~/projects/opentrons.
PRODUCTION_PLATFORM_OPENTRONS_FLASH_DIR=/opentrons

# Runtime profile. In local development authentication stays in SQLite while
# business documents use separate *_dev MongoDB databases and robot discovery
# uses the real network. Production (RUN_ENV=server) keeps the original DB names.
PRODUCTION_PLATFORM_RUN_ENV=dev
PRODUCTION_PLATFORM_AUTH_STORAGE=sqlite
PRODUCTION_PLATFORM_DEVICE_SCAN_MODE=real
PRODUCTION_PLATFORM_MONGO_URI=mongodb://192.168.6.55:27017
# Optional when MONGO_URI is empty. Connecting to the same host is safe for DB
# isolation: dev always adds _dev, including explicitly configured DB names.
PRODUCTION_PLATFORM_MONGO_HOST=192.168.6.55
PRODUCTION_PLATFORM_MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
PRODUCTION_PLATFORM_MONGO_CONNECT_TIMEOUT_MS=5000
PRODUCTION_PLATFORM_MONGO_SOCKET_TIMEOUT_MS=30000
PRODUCTION_PLATFORM_MONGO_CONNECT_ATTEMPTS=3
PRODUCTION_PLATFORM_MONGO_CONNECT_RETRY_DELAY_MS=500
# Base name: resolves to ProductionsMessage_dev in dev, ProductionsMessage on server.
PRODUCTION_PLATFORM_MESSAGE_DATABASE=ProductionsMessage
# Dev uses MongoDB first and switches business documents to SQLite when it is unreachable.
PRODUCTION_PLATFORM_DEV_SQLITE_FALLBACK_ENABLED=true

# Durable upload queue and retry policy.
PRODUCTION_PLATFORM_UPLOAD_SCHEDULER_POLL_SECONDS=2
PRODUCTION_PLATFORM_UPLOAD_MAX_WORKERS=2
PRODUCTION_PLATFORM_UPLOAD_MAX_ATTEMPTS=4
PRODUCTION_PLATFORM_UPLOAD_RETRY_BASE_SECONDS=5
PRODUCTION_PLATFORM_UPLOAD_RETRY_MAX_SECONDS=300
PRODUCTION_PLATFORM_UPLOAD_LEASE_SECONDS=1800
PRODUCTION_PLATFORM_UPLOAD_NOTIFICATION_MAX_ATTEMPTS=5

# Engineering change dashboard. Pages read this dedicated local index immediately;
# Google Drive is scanned for new current-year files in the background once per day.
PRODUCTION_PLATFORM_INFORMATION_REFRESH_SECONDS=86400
# PRODUCTION_PLATFORM_ENGINEERING_INFORMATION_DB_PATH=/data/engineering_information.sqlite3
# Optional server-side Google service account. Share both source folders with
# this account as Viewer. Defaults to /configs/service-account.json on servers.
# PRODUCTION_PLATFORM_GOOGLE_SERVICE_ACCOUNT_PATH=/configs/service-account.json

# Platform login. Generate the JWT secret with: openssl rand -hex 32
PRODUCTION_PLATFORM_AUTH_JWT_SECRET=
PRODUCTION_PLATFORM_AUTH_ACCESS_TOKEN_MINUTES=5
PRODUCTION_PLATFORM_AUTH_REFRESH_TOKEN_HOURS=360
PRODUCTION_PLATFORM_AUTH_COOKIE_SECURE=true
# Keep empty for the default same-origin deployment. Comma-separate explicit origins when needed.
PRODUCTION_PLATFORM_AUTH_ALLOWED_ORIGINS=
# Fixed Bearer token for GET /api/integrations/collection-data. Use at least 32 random characters.
PRODUCTION_PLATFORM_COLLECTION_DATA_ACCESS_TOKEN=

# OT3 image library and durable update/download task history (single API worker).
PRODUCTION_PLATFORM_OT3_SYSTEM_DIR=/opt/ot3-system
# PRODUCTION_PLATFORM_OT3_TASK_DIR=/opt/production-platform/apps/backend/db-storage/business/system-image-tasks

# Failed pipette QC evidence (JSON manifests, readable logs, optional encoder CSV).
# The backend reads this server-local directory; original reports are never modified.
PRODUCTION_PLATFORM_TEST_FAILURE_DIR=/opt/pipette_assembly_qc_log
PRODUCTION_PLATFORM_TEST_FAILURE_SCAN_SECONDS=60

# 按 SN + report_run_id 匹配总表报告链接；后台读取，不修改总表或原始报告。
# 复用 PRODUCTION_PLATFORM_GOOGLE_TOKEN_PATH / GOOGLE_SERVICE_ACCOUNT_PATH 指定的账号。
PRODUCTION_PLATFORM_TEST_FAILURE_REPORT_LINKS_ENABLED=true
# 8ch 总表；保留原配置名称。两个通道的总表 ID 均有内置默认值。
PRODUCTION_PLATFORM_TEST_FAILURE_REPORT_SHEET_ID=16GY8f7p788fbwxxIEH_Azn1RB-NWl3N7cRZzz-6SA_E
# 各自留空搜索对应总表全部工作表；仅需特定页时填写逗号分隔 gid。
PRODUCTION_PLATFORM_TEST_FAILURE_REPORT_SHEET_GIDS=
# 1ch 总表；使用相同 Google 账号，权限与缓存按总表独立处理。
PRODUCTION_PLATFORM_TEST_FAILURE_REPORT_1CH_SHEET_ID=1eHeq3W0Mr-X6nC0MkNZuuS3DLW097Xtwl2pTkIEpSOU
PRODUCTION_PLATFORM_TEST_FAILURE_REPORT_1CH_SHEET_GIDS=
PRODUCTION_PLATFORM_TEST_FAILURE_REPORT_LINK_REFRESH_SECONDS=300

# Failure-analysis page: on-demand only; no standalone watcher or deployment.
# Rules work without a model. Enable Ollama assistance explicitly when available
# on the same machine as the backend (this does not use the platform LLM API key).
PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_MODEL_ENABLED=false
PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_MODEL_BASE_URL=http://127.0.0.1:11434
PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_MODEL=qwen3:8b
PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_MODEL_TIMEOUT_SECONDS=240
# 独立证据包的后台并发上限；达到上限时提示稍后重试
PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_RULES_CONCURRENCY=3
PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_MODEL_CONCURRENCY=1
# 每份证据包保留最近 N 次分析缓存；原始报告、返修确认历史始终保留
PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_RETAIN_RESULTS=3
# Defaults to DATA_DIR/defect-search/test-failure-analysis, separate from originals.
# PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_DIR=/data/defect-search/test-failure-analysis
# Optional trusted protocol source used only to compare recorded SHA256 values.
# PRODUCTION_PLATFORM_TEST_FAILURE_ANALYSIS_PROTOCOL_SOURCE_PATH=/path/to/pipette_assembly_qc_ot3.py
