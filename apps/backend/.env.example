PRODUCTION_PLATFORM_DURO_API_KEY=
PRODUCTION_PLATFORM_DURO_REMOTE_CHROME_URL=http://127.0.0.1:9222
PRODUCTION_PLATFORM_DURO_REMOTE_CHROME_APP_URL=https://mfg.duro.app/dashboard
PRODUCTION_PLATFORM_DURO_REMOTE_CHROME_TIMEOUT_SECONDS=30
PRODUCTION_PLATFORM_LLM_API_KEY=
PRODUCTION_PLATFORM_LLM_BASE_URL=https://api.deepseek.com/v1
PRODUCTION_PLATFORM_LLM_MODEL=deepseek-chat
PRODUCTION_PLATFORM_LLM_TIMEOUT_SECONDS=90
# Optional, colon-separated on Linux/macOS. Defaults: ~/projects/opentrons,
# ~/projects/opentorns (legacy typo), and /opentrons.
PRODUCTION_PLATFORM_OPENTRONS_SOURCE_ROOTS=
# Optional directory containing setup_ssh_keys.sh. Defaults: /ssh-ot3,
# ~/ssh-ot3, and ~/projects/ssh-ot3.
PRODUCTION_PLATFORM_SSH_OT3_DIR=
# Directory containing the Opentrons Makefile used by the single-device code flash page.
# Defaults to /opentrons on the deployed server.
PRODUCTION_PLATFORM_OPENTRONS_FLASH_DIR=/opentrons

# Platform login. Generate the JWT secret with: openssl rand -hex 32
PRODUCTION_PLATFORM_AUTH_JWT_SECRET=
PRODUCTION_PLATFORM_AUTH_ACCESS_TOKEN_MINUTES=20
PRODUCTION_PLATFORM_AUTH_REFRESH_TOKEN_HOURS=168
PRODUCTION_PLATFORM_AUTH_COOKIE_SECURE=true
# Keep empty for the default same-origin deployment. Comma-separate explicit origins when needed.
PRODUCTION_PLATFORM_AUTH_ALLOWED_ORIGINS=
