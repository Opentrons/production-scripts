PRODUCTION_PLATFORM_DURO_API_KEY=
# Bridge GPT Token credentials stay in git-ignored auth-files.
PRODUCTION_PLATFORM_BRIDGE_ENV_FILE=apps/backend/auth-files/bridgefloods.env
PRODUCTION_PLATFORM_BRIDGE_ACCESS_TOKEN=
PRODUCTION_PLATFORM_BRIDGE_REFRESH_TOKEN=
PRODUCTION_PLATFORM_BRIDGE_WHITELIST_PATH=apps/backend/auth-files/bridgefloods_whitelist.csv
PRODUCTION_PLATFORM_BRIDGE_AUTOMATION_ENABLED=false
PRODUCTION_PLATFORM_BRIDGE_EMAIL_PROVIDER=gmail
PRODUCTION_PLATFORM_BRIDGE_GMAIL_TOKEN_PATH=apps/backend/auth-files/bridge-gmail-token.json
PRODUCTION_PLATFORM_BRIDGE_EMAIL_FROM=
PRODUCTION_PLATFORM_BRIDGE_ADMIN_EMAIL=
PRODUCTION_PLATFORM_BRIDGE_SMTP_HOST=
PRODUCTION_PLATFORM_BRIDGE_SMTP_PORT=587
PRODUCTION_PLATFORM_BRIDGE_SMTP_USERNAME=
PRODUCTION_PLATFORM_BRIDGE_SMTP_PASSWORD=
PRODUCTION_PLATFORM_BRIDGE_SMTP_SSL=false
PRODUCTION_PLATFORM_BRIDGE_SMTP_STARTTLS=true
# Standard OpenAI-compatible names. These take precedence when configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# Legacy platform-specific names remain supported for existing deployments.
PRODUCTION_PLATFORM_DURO_BASE_URL=https://mfgapi.duro.app/v1
PRODUCTION_PLATFORM_SUPPLEMENTARY_MATERIALS_DB_PATH=
PRODUCTION_PLATFORM_LLM_API_KEY=
PRODUCTION_PLATFORM_LLM_BASE_URL=https://api.deepseek.com/v1
PRODUCTION_PLATFORM_LLM_MODEL=deepseek-chat
PRODUCTION_PLATFORM_LLM_TIMEOUT_SECONDS=180
PRODUCTION_PLATFORM_LLM_SOP_CHUNK_CHARS=16000
PRODUCTION_PLATFORM_LLM_SOP_MAX_TOKENS=8192
PRODUCTION_PLATFORM_LLM_SEMANTIC_MAX_WORKERS=4
PRODUCTION_PLATFORM_SOP_FULL_SEMANTIC_MAX_REFERENCES=120
# Optional, colon-separated on Linux/macOS. Defaults: ~/projects/opentrons,
# ~/projects/opentorns (legacy typo), and /opentrons.
PRODUCTION_PLATFORM_OPENTRONS_SOURCE_ROOTS=
# Optional directory containing setup_ssh_keys.sh. Defaults: /ssh-ot3,
# ~/ssh-ot3, and ~/projects/ssh-ot3.
PRODUCTION_PLATFORM_SSH_OT3_DIR=
# Directory containing the Opentrons Makefile used by the code flash page.
# Defaults to /opentrons, then ~/projects/opentrons.
PRODUCTION_PLATFORM_OPENTRONS_FLASH_DIR=/opentrons

# Runtime profile. In local development authentication stays in SQLite while
# business documents remain in MongoDB and robot discovery uses the real network.
PRODUCTION_PLATFORM_RUN_ENV=dev
PRODUCTION_PLATFORM_AUTH_STORAGE=sqlite
PRODUCTION_PLATFORM_DEVICE_SCAN_MODE=real
PRODUCTION_PLATFORM_MONGO_URI=mongodb://127.0.0.1:27017
# Optional when MONGO_URI is empty. Local development defaults to 127.0.0.1.
PRODUCTION_PLATFORM_MONGO_HOST=127.0.0.1
PRODUCTION_PLATFORM_MESSAGE_DATABASE=ProductionsMessage
# Dev uses MongoDB first and switches business documents to SQLite when it is unreachable.
PRODUCTION_PLATFORM_DEV_SQLITE_FALLBACK_ENABLED=true

# Durable upload queue and retry policy.
PRODUCTION_PLATFORM_UPLOAD_SCHEDULER_POLL_SECONDS=2
PRODUCTION_PLATFORM_UPLOAD_MAX_WORKERS=2
PRODUCTION_PLATFORM_UPLOAD_MAX_ATTEMPTS=4
PRODUCTION_PLATFORM_UPLOAD_RETRY_BASE_SECONDS=5
PRODUCTION_PLATFORM_UPLOAD_RETRY_MAX_SECONDS=300
PRODUCTION_PLATFORM_UPLOAD_LEASE_SECONDS=1800
PRODUCTION_PLATFORM_UPLOAD_NOTIFICATION_MAX_ATTEMPTS=5

# Platform login. Generate the JWT secret with: openssl rand -hex 32
PRODUCTION_PLATFORM_AUTH_JWT_SECRET=
PRODUCTION_PLATFORM_AUTH_ACCESS_TOKEN_MINUTES=5
PRODUCTION_PLATFORM_AUTH_REFRESH_TOKEN_HOURS=24
PRODUCTION_PLATFORM_AUTH_COOKIE_SECURE=true
# Keep empty for the default same-origin deployment. Comma-separate explicit origins when needed.
PRODUCTION_PLATFORM_AUTH_ALLOWED_ORIGINS=
# Fixed Bearer token for GET /api/integrations/collection-data. Use at least 32 random characters.
PRODUCTION_PLATFORM_COLLECTION_DATA_ACCESS_TOKEN=
